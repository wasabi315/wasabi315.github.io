---
import { getRelativeLocaleUrl } from "astro:i18n";

type Props = {
  tag: string;
};

const { tag } = Astro.props;
const url = getRelativeLocaleUrl(Astro.currentLocale!, `tags/${tag}`);
---

<a href={url}>
  {tag}
</a>

<style lang="scss">
  a {
    &::before {
      content: "#";
    }
    color: inherit;
    &:hover,
    &:focus {
      color: var(--accent);
    }
  }
</style>
